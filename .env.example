# Copy this file to .env (at the project root) and adjust as needed.
# backend/database/connection.py and backend/main.py both load this file
# automatically via python-dotenv - no manual export needed.

# PostgreSQL connection string used by the backend.
# If you run `docker-compose up -d postgres` (see docker-compose.yml), the
# default below already matches: user "postgres", password "postgres",
# database "traceiq", exposed on localhost:5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traceiq

# Where uploaded PCAP/PCAPNG files are stored on disk. Created automatically
# on backend startup if it doesn't exist.
PCAP_STORAGE_DIR=./pcap-storage

# Reserved for when the in-memory job queue (backend/services/queue.py) is
# swapped for a real Redis-backed queue. Not used yet.
REDIS_URL=redis://localhost:6379
